@model List<MedLink.Model.Entities.Specialty>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Specialties";
}

<div class="admin-topbar">
    <h1 class="mt-0 mb-0">Medical Specialties</h1>
    <a href="/admin/specialties/create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add Specialty</a>
</div>

<div class="card table-wrap" style="max-width: 800px;">
    <table class="table">
        <thead>
            <tr>
                <th>Icon</th>
                <th>Specialty Name</th>
                <th>Description</th>
                <th>Active Doctors</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td><i class="fa-solid @s.Icon text-teal" style="font-size: 1.2rem;"></i></td>
                    <td><strong>@s.Name</strong></td>
                    <td>@s.Description</td>
                    <td>@s.Doctors.Count()</td>
                </tr>
            }
        </tbody>
    </table>
</div>