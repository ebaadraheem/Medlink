@model MedLink.Presenter.ViewModels.SpecialtyViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Specialty";
}

<div class="admin-topbar">
    <h1 class="mt-0 mb-0">Add Specialty</h1>
    <a href="/admin/specialties" class="btn btn-ghost">Cancel</a>
</div>

<div class="card p-4" style="max-width: 600px;">
    <form action="/admin/specialties/create" method="post">
        
        <div class="form-group">
            <label class="form-label">Specialty Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="form-group">
            <label class="form-label">FontAwesome Icon Class</label>
            <input asp-for="Icon" class="form-control" placeholder="e.g. fa-heart-pulse" required />
            <div class="form-hint">Browse icons at fontawesome.com/icons</div>
        </div>

        <div class="form-group">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save Specialty</button>
    </form>
</div>