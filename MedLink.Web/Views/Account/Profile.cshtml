@model MedLink.Presenter.ViewModels.PatientProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container section-sm" style="max-width: 600px;">
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}
    <h1 class="display mb-4">Patient Profile</h1>
    
    <div class="card p-4">
        <form asp-action="Profile" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            
            <div class="d-flex gap-2">
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Student ID</label>
                    <input asp-for="StudentId" class="form-control" />
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Department</label>
                    <input asp-for="Department" class="form-control" />
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Blood Group</label>
                    <input asp-for="BloodGroup" class="form-control" placeholder="e.g. O+" />
                    <span asp-validation-for="BloodGroup" class="text-danger"></span>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label class="form-label">Emergency Contact</label>
                    <input asp-for="EmergencyContact" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Medical History (Optional)</label>
                <textarea asp-for="MedicalHistory" class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Save Profile</button>
        </form>
    </div>
</div>