@model MedLink.Presenter.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = "Book Appointment";
    var doctor = ViewBag.Doctor as MedLink.Presenter.ViewModels.DoctorDetailViewModel;
}

<div class="container section-sm" style="max-width: 700px;">
    <h1 class="display mb-4">Complete Your Booking</h1>
    
    <div class="card" style="padding: 1.5rem;">
        <div class="d-flex align-center gap-2 mb-4" style="background: var(--teal-50); border-radius: var(--radius-md);">
            <div class="doctor-card-avatar" style="width: 60px; height: 60px; font-size: 1.5rem;">@Model.DoctorName.Substring(0,1)</div>
            <div>
                <h3 class="mb-0 mt-0">@Model.DoctorName</h3>
                <div class="text-sm text-teal">@Model.DoctorSpecialty</div>
            </div>
            <div style="margin-left: auto; text-align: right;">
                <div class="text-sm text-muted">Consultation Fee</div>
                <strong>Rs. @Model.Fee</strong>
            </div>
        </div>

        <form asp-action="Book" method="post">
            <input type="hidden" asp-for="DoctorId" />
            <input type="hidden" asp-for="TimeSlotId" id="TimeSlotId" value="0" />
            
            <input type="hidden" asp-for="DoctorName" />
            <input type="hidden" asp-for="DoctorSpecialty" />
            <input type="hidden" asp-for="Fee" />
            

            <div class="form-group">
                <label class="form-label">Select Date</label>
                <input asp-for="AppointmentDate" type="date" class="form-control" id="AppointmentDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Available Time Slots</label>
                <div id="slotContainer" class="slot-grid">
                    <div class="text-sm text-muted">Please select time as per availability</div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Reason for Visit (Optional)</label>
                <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
            </div>

            <button type="submit" class="btn btn-primary mt-2" style="width: 100%; justify-content: center;">Confirm Booking</button>
        </form>
    </div>
</div>