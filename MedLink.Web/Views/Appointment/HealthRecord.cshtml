@model MedLink.Presenter.ViewModels.HealthRecordViewModel
@{
    ViewData["Title"] = "Health Record";
}

<div class="container section-sm" style="max-width: 800px;">
    <div class="d-flex justify-between align-center mb-4">
        <h1 class="display mt-0 mb-0">Health Record</h1>
        <a asp-action="Index" class="btn btn-outline">Back to Appointments</a>
    </div>

    <div class="card p-4">
        <div class="d-flex justify-between mb-4" style="border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
            <div>
                <h3 class="mt-0 mb-0">@Model.DoctorName</h3>
                <div class="text-muted text-sm">Appointment: @Model.AppointmentNumber</div>
            </div>
            <div class="text-right">
                <h3 class="mt-0 mb-0">@Model.VisitDate.ToString("MMM dd, yyyy")</h3>
                <div class="text-muted text-sm">Patient: @Model.PatientName</div>
            </div>
        </div>

        <div class="d-flex gap-2 mb-4" style="background: var(--ivory-dk); border-radius: var(--radius-sm); padding: 1rem; flex-wrap: wrap;">
            <div><strong>Weight:</strong> @(Model.Weight?.ToString("0.0") ?? "--") kg</div>
            <div class="mx-2">|</div>
            <div><strong>Height:</strong> @(Model.Height?.ToString("0.0") ?? "--") cm</div>
            <div class="mx-2">|</div>
            <div><strong>BP:</strong> @(Model.BloodPressure ?? "--")</div>
            <div class="mx-2">|</div>
            <div><strong>Temp:</strong> @(Model.Temperature?.ToString("0.0") ?? "--") °C</div>
        </div>

        <div class="mb-4">
            <h4 class="text-teal mb-2">Diagnosis</h4>
            <p class="mt-0">@Model.Diagnosis</p>
        </div>

        <div class="mb-4">
            <h4 class="text-teal mb-2">Prescription</h4>
            <div style="background: var(--ivory-dk); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1rem; white-space: pre-wrap; font-family: var(--font-mono);">
        </div>

        @if (!string.IsNullOrEmpty(Model.DoctorNotes))
        {
            <div class="mb-4">
                <h4 class="text-teal mb-2">Doctor Notes</h4>
                <p class="mt-0 text-sm">@Model.DoctorNotes</p>
            </div>
        }
    </div>
</div>