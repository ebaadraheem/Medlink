@model List<MedLink.Presenter.ViewModels.AppointmentViewModel>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container section-sm">
    <div class="d-flex justify-between align-center mb-4">
        <h1 class="display mt-0 mb-0">My Appointments</h1>
        <a asp-controller="Home" asp-action="Doctors" class="btn btn-primary" style="margin-left: 0.60rem;">Book New</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You don't have any appointments yet.</div>
    }
    else
    {
        <div class="table-wrap card">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Doctor</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td data-label="Date & Time">
                                <strong>@appt.AppointmentDate.ToString("MMM dd, yyyy")</strong><br/>
                                <span class="text-sm">@appt.TimeDisplay</span>
                            </td>
                            <td data-label="Doctor">
                                <strong class="text-teal">@appt.DoctorName</strong><br/>
                                <span class="text-sm">@appt.DoctorSpecialty</span>
                            </td>
                            <td data-label="Status">
                                <span class="badge status-@appt.Status.ToString().ToLower()">@appt.StatusLabel</span>
                            </td>
                            <td data-label="Actions">
                            <td>
                                @if (appt.Status == MedLink.Model.Enums.AppointmentStatus.Pending || appt.Status == MedLink.Model.Enums.AppointmentStatus.Confirmed)
                                {
                                    <form asp-action="Cancel" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                        <input type="hidden" name="id" value="@appt.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                                    </form>
                                }
                                @if (appt.HasHealthRecord)
                                {
                                    <a asp-action="HealthRecord" asp-route-id="@appt.HealthRecordId" class="btn btn-outline btn-sm">View Record</a>
                                }
                                
                                @if (appt.Status == MedLink.Model.Enums.AppointmentStatus.Completed)
                                {
                                    @if(appt.HasReviewed)
                                    {
                                        <div class="mt-2 p-2" style="background:var(--ivory-dk); border-radius: var(--radius-sm); font-size: 0.85rem;">
                                            <div class="mb-1">
                                                @for(int i=1; i<=5; i++)
                                                {
                                                    <i class="fa-solid fa-star @(i <= appt.ExistingRating ? "" : "empty")" style="@(i <= appt.ExistingRating ? "color: #F0A030;" : "color: #D1D5DB;")"></i>
                                                }
                                            </div>
                                            <p class="mt-0 mb-1 text-muted">"@appt.ExistingReviewComment"</p>
                                        </div>
                                        <button type="button" class="btn btn-ghost btn-sm mt-1" onclick="document.getElementById('review-box-@appt.Id').style.display='block'">Edit Review</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm mt-1" onclick="document.getElementById('review-box-@appt.Id').style.display='block'">Leave Review</button>
                                    }
                                    
                                    <div id="review-box-@appt.Id" style="display:none; margin-top:10px; padding:15px; background:var(--color-bg-secondary); border-radius:8px;">
                                        <form asp-action="Review" method="post">
                                            <input type="hidden" name="DoctorId" value="@appt.DoctorId" />
                                            <div class="form-group mb-2">
                                                <select name="Rating" class="form-control" required>
                                                    <option value="">Select Rating...</option>
                                                    <option value="5" selected="@(appt.ExistingRating == 5 ? "selected" : null)">⭐⭐⭐⭐⭐ (5/5)</option>
                                                    <option value="4" selected="@(appt.ExistingRating == 4 ? "selected" : null)">⭐⭐⭐⭐ (4/5)</option>
                                                    <option value="3" selected="@(appt.ExistingRating == 3 ? "selected" : null)">⭐⭐⭐ (3/5)</option>
                                                    <option value="2" selected="@(appt.ExistingRating == 2 ? "selected" : null)">⭐⭐ (2/5)</option>
                                                    <option value="1" selected="@(appt.ExistingRating == 1 ? "selected" : null)">⭐ (1/5)</option>
                                                </select>
                                            </div>
                                            <div class="form-group mb-2">
                                                <textarea name="Comment" class="form-control" placeholder="Write your review here..." rows="2" required>@appt.ExistingReviewComment</textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-sm w-100" style="justify-content:center;">Submit Review</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>